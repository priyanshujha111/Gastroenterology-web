# Apache config for the React (Vite) single-page app on shared hosting.
# Vite copies this file from public/ into dist/ on every build.

# Send every route that is not a real file or folder (e.g. /about, /courses/some-course)
# to index.html, so React Router can handle it instead of Apache returning a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Always re-check index.html so visitors pick up a new deploy right away.
# Files in assets/ have content hashes in their names, so they can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
